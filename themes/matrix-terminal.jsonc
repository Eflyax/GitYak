{
	"meta": {
		"name": "Matrix Terminal",
		"scheme": "dark"
	},
	"themeValues": {
		// values applied to the entire app
		"root": {
			// Core Colors
			"white": "#D6FFE0",
			"black": "#000000",
			"red": "#FF4B4B",
			"orange": "#B8FF3A",
			"yellow": "#D7FF3A",
			"green": "#00FF41",
			"teal": "#00FFC8",
			"blue": "#35C6FF",
			"ltblue": "#00FFC8",
			"purple": "#7CFF4D",

			// Background and panels
			"app__bg0": "#000000",
			"toolbar__bg0": "#000000",
			"toolbar__bg1": "#020802",
			"toolbar__bg2": "#041004",
			"panel__bg0": "#000000",
			"panel__bg1": "#020802",
			"panel__bg2": "#041004",
			"glass": "rgba(0,0,0,.6)",
			"glass-inverse-10": "fade(@white, 10%)",
			"glass-inverse-5": "fade(@white, 5%)",
			"input__bg": "#031003",
			"input-bg-warn-color": "fade(@orange, 60%)",
			"panel-accent": "#00FF41",
			"panel-border": "fade(@white, 12%)",
			"section-border": "fade(@white, 12%)",
			"subtle-border": "fade(@white, 6%)",
			"modal-overlay-color": "rgba(0,0,0,.7)",

			// Graph colors
			"graph-color-0": "#00FF41",
			"graph-color-1": "#7CFF4D",
			"graph-color-2": "#00D936",
			"graph-color-3": "#B8FF3A",
			"graph-color-4": "#00FFC8",
			"graph-color-5": "#35C6FF",
			"graph-color-6": "#00A62A",
			"graph-color-7": "#D7FF3A",
			"graph-color-8": "#3AFFB0",
			"graph-color-9": "#9EFFB8",
			"stats-added-color": "@green",
			"stats-deleted-color": "@red",
			"stats-files-color": "@yellow",

			// Text colors
			// values starting with . aren't added to the CSS, they're just variables
			".text-color": "#C8FFD4",
			"text-selected": "@.text-color",
			"text-normal": "fade(@.text-color, 85%)",
			"text-secondary": "fade(@.text-color, 65%)",
			"text-disabled": "fade(@.text-color, 42%)",
			"text-accent": "#00FF41",
			"text-inverse": "#000000",
			"text-bright": "@.text-color",
			"text-dimmed": "fade(@text-normal, 20%)",
			"text-dimmed-selected": "fade(@text-dimmed, 50%)",
			"text-selected-row": "@.text-color",

			// Buttons
			"btn-text": "@text-normal",
			"btn-text-hover": "@text-selected",
			"default-border": "@text-normal",
			"default-bg": "transparent",
			"default-hover": "transparent",
			"default-border-hover": "@text-selected",
			"primary-border": "@blue",
			"primary-bg": "fade(@blue, 10%)",
			"primary-hover": "fade(@blue, 40%)",
			"success-border": "@green",
			"success-bg": "fade(@green, 10%)",
			"success-hover": "fade(@green, 40%)",
			"warning-border": "@orange",
			"warning-bg": "fade(@orange, 10%)",
			"warning-hover": "fade(@orange, 35%)",
			"danger-border": "@red",
			"danger-bg": "fade(@red, 10%)",
			"danger-hover": "fade(@red, 40%)",
			"hover-row": "fade(@blue, 15%)",
			"danger-row": "fade(@red, 40%)",
			"selected-row": "fade(@blue, 22%)",
			"selected-row-border": "none",
			"warning-row": "fade(@orange, 40%)",

			// Actions
			"droppable": "fade(@yellow, 30%)",
			"drop-target": "fade(@green, 50%)",
			"input--disabled": "fade(@black, 10%)",
			"link-color": "#00FFC8",
			"link-color-bright": "#00FFC8",
			"form-control-focus": "@blue",
			"scroll-thumb-border": "rgba(0,0,0,0)",
			"scroll-thumb-bg": "rgba(255,255,255,0.15)",
			"scroll-thumb-bg-light": "rgba(0,0,0,0.15)",
			"wip-status": "fade(@blue, 40%)",
			"card__bg": "@panel__bg2",
			"card-shadow": "rgba(0,0,0,.2)",
			"statusbar__warning-bg": "mixLess(@graph-color-7, @app__bg0, 50%)",
			"label__yellow-color": "#D7FF3A",
			"label__light-blue-color": "#00FFC8",
			"label__purple-color": "#7CFF4D",
			"filtering": "fade(@blue, 50%)",
			"soloing": "fade(@orange, 50%)",
			"checked-out": "fade(@green, 30%)",
			"soloed": "fade(@orange, 30%)",
			"filter-match": "fade(@blue, 50%)",
			"clone__progress": "fade(@blue, 70%)",
			"toolbar__prompt": "fade(@blue, 20%)",
			"verified": "fade(@green, 30%)",
			"unverified": "fade(@white, 10%)",
			"drop-sort-border": "@green",

			// Terminal
			"terminal__repo-name-color": "#00FFC8",
			"terminal__repo-branch-color": "#7CFF4D",
			"terminal__repo-tag-color": "#FF4B4B",
			"terminal__repo-upstream-color": "#00FF41",
			"terminal__background": "#000000",
			"terminal__cursor": "#00FF41",
			"terminal__cursorAccent": "#000000",
			"terminal__foreground": "#00FF41",
			"terminal__selection": "#0A3D14",
			"terminal__black": "#000000",
			"terminal__red": "#FF4B4B",
			"terminal__green": "#00FF41",
			"terminal__yellow": "#D7FF3A",
			"terminal__blue": "#35C6FF",
			"terminal__magenta": "#7CFF4D",
			"terminal__cyan": "#00FFC8",
			"terminal__white": "#C8FFD4",
			"terminal__brightBlack": "#1A4D24",
			"terminal__brightRed": "#FF6B6B",
			"terminal__brightGreen": "#5CFF7A",
			"terminal__brightYellow": "#E8FF6B",
			"terminal__brightBlue": "#6BD9FF",
			"terminal__brightMagenta": "#A3FF7A",
			"terminal__brightCyan": "#5CFFD9",
			"terminal__brightWhite": "#E8FFEE",

			// Code editor
			"code-bg": "#000000",
			"code-foreground": "@text-normal",
			"code-blame-color-0": "@graph-color-0",
			"code-blame-color-1": "@graph-color-1",
			"code-blame-color-2": "@graph-color-2",
			"code-blame-color-3": "@graph-color-3",
			"code-blame-color-4": "@graph-color-4",
			"code-blame-color-5": "@graph-color-5",
			"code-blame-color-6": "@graph-color-6",
			"code-blame-color-7": "@graph-color-7",
			"code-blame-color-8": "@graph-color-8",
			"code-blame-color-9": "@graph-color-9",
			"added-line": "fade(@green, 20%)",
			"deleted-line": "fade(@red, 20%)",
			"modified-line": "fade(@white, 10%)",
			"conflict-info-color": "#00FFC8",
			"conflict-left-border-color": "#00FFC8",
			"conflict-left-color": "fade(@conflict-left-border-color, 25%)",
			"conflict-right-border-color": "#D7FF3A",
			"conflict-right-color": "fade(@conflict-right-border-color, 25%)",
			"conflict-output-border-color": "#35C6FF",
			"conflict-output-color": "fade(@conflict-output-border-color, 25%)"
		},
		// Override specific values just for the toolbar
		"toolbar": {
			"text-selected": "#C8FFD4",
			"text-normal": "fade(#C8FFD4, 90%)",
			"text-secondary": "fade(#C8FFD4, 70%)",
			"text-disabled": "fade(#C8FFD4, 42%)",
			"section-border": "fade(#C8FFD4, 20%)",
			"input__bg": "#031003",
			"link-color": "#00FFC8",
			"btn-text": "var(--text-normal)"
		},
		// Override specific values just for the tabsbar
		"tabsbar": {
			"text-selected": "#C8FFD4",
			"text-normal": "fade(#C8FFD4, 90%)",
			"text-secondary": "fade(#C8FFD4, 70%)",
			"text-disabled": "fade(#C8FFD4, 42%)",
			"section-border": "fade(#C8FFD4, 20%)",
			"input__bg": "#031003",
			"link-color": "#00FFC8",
			"btn-text": "var(--text-normal)"
		}
	}
}
