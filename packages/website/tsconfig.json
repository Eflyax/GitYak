{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "node"],
		"paths": {
			"@git-yak/protocol": ["../protocol/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "vite.config.ts"]
}
