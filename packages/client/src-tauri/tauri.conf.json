{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitYak",
  "version": "2.2.0",
  "identifier": "com.git-yak.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMDM2RDA2QjkzMTM1MTEKUldRUk5URzVCbTBEamh5d1RkdnlDOU94aEQwWG84a21CamRCRnltMlN1aVZPbVh5SXUydXpXYzgK",
      "endpoints": ["https://gityak.com/releases/updater.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["gityak"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../remote-worker/dist/remote-worker-linux-x64": "remote-worker-linux-x64"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["git", "openssh-client"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "GitYak",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
